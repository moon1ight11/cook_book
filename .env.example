# --- Server ---
API_PORT=8080
COOKBOOK_LOGGER_LEVEL=info

# --- MongoDB ---
MONGO_DB_NAME=cook_book
MONGO_ROOT_USER=cookbook_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_MONGO_PASSWORD

# --- App Admin ---
COOKBOOK_ADMIN_NAME=admin
COOKBOOK_ADMIN_EMAIL=admin@example.com
COOKBOOK_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# --- JWT Secrets ---
COOKBOOK_JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_HEX_64_CHARS
COOKBOOK_JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_RANDOM_HEX_64_CHARS
COOKBOOK_JWT_ACCESS_EXPIRY=15m
COOKBOOK_JWT_REFRESH_EXPIRY=24h

# --- Monitoring & Tools ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=CHANGE_ME_MONGO_EXPRESS_PASSWORD

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080